{
  "permissions": {
    "deny": [
      "Edit",
      "Write",
      "Read(../**)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"" }
        ]
      }
    ]
  }
}
